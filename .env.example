LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 历史摘要压缩模型（可选，未配置则使用上面的 OPENAI_* 配置）
SUMMARY_MODEL=
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
# 摘要模型采样温度，建议 0~0.3，越低摘要越稳定、越忠实于原文
SUMMARY_TEMPERATURE=0.2
# 摘要模型单次最大输出 token 数（中文约 1 字 ≈ 1 token），需大于摘要字数上限（默认 1500 字），过小会导致摘要被截断
SUMMARY_MAX_TOKENS=2048

TAVILY_API_KEY=

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=

QDRANT_PATH=
DB_PATH=