# ==============================================================================
# LangSmith 监控追踪配置（可选）
# ==============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ==============================================================================
# 全局默认模型配置（所有 Agent 留空时默认继承这里的配置，模型 Provider 默认为 openai）
# ==============================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ==============================================================================
# 各 Agent 独立模型配置（可选：留空则自动回退继承上方的 OPENAI_* 配置）
# 系统支持在 Gradio 界面中为各角色独立切换模型，优先级：界面覆盖 > 下方专属配置 > 默认 OPENAI_*
# ==============================================================================

# 【主 Agent / 调度者】（负责任务分析、简单任务直办与复杂任务流转调度，建议选用高推理/高智商模型）
MAIN_AGENT_PROVIDER=openai
MAIN_AGENT_MODEL=
MAIN_AGENT_BASE_URL=
MAIN_AGENT_API_KEY=
MAIN_AGENT_TEMPERATURE=

# 【设计 Agent】（负责需求分析并产出高保真 HTML/SVG 交互设计稿，建议选用擅长前端代码与视觉设计的模型）
DESIGN_AGENT_PROVIDER=openai
DESIGN_AGENT_MODEL=
DESIGN_AGENT_BASE_URL=
DESIGN_AGENT_API_KEY=
DESIGN_AGENT_TEMPERATURE=

# 【编码 Agent】（负责根据已确认的设计稿完整编写代码，建议选用编程专精模型）
CODING_AGENT_PROVIDER=openai
CODING_AGENT_MODEL=
CODING_AGENT_BASE_URL=
CODING_AGENT_API_KEY=
CODING_AGENT_TEMPERATURE=

# 【测试 Agent】（负责在设计阶段编写测试用例、在编码完成后执行自动化测试与静态审查）
TEST_AGENT_PROVIDER=openai
TEST_AGENT_MODEL=
TEST_AGENT_BASE_URL=
TEST_AGENT_API_KEY=
TEST_AGENT_TEMPERATURE=

# ==============================================================================
# 历史对话摘要压缩模型（可选，未配置则使用全局 OPENAI_* 配置）
# ==============================================================================
SUMMARY_MODEL=
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
# 摘要模型采样温度，建议 0~0.3，越低摘要越稳定、越忠实于原文
SUMMARY_TEMPERATURE=0.2
# 摘要模型单次最大输出 token 数（中文约 1 字 ≈ 1 token），需大于摘要字数上限（默认 1500 字），过小会导致摘要被截断
SUMMARY_MAX_TOKENS=2048

# ==============================================================================
# 外部检索与工具配置
# ==============================================================================
# Tavily 网页搜索 API Key（用于联网检索工具）
TAVILY_API_KEY=

# ==============================================================================
# RAG 代码知识库与嵌入向量模型配置
# ==============================================================================
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=

# 向量数据库与本地数据存储路径
QDRANT_PATH=
DB_PATH=